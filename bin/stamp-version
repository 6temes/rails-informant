#!/usr/bin/env ruby

require "open3"

abort "usage: bin/stamp-version VERSION FILE" unless ARGV.size == 2

version, path = ARGV

unless Gem::Version.correct?(version) && Gem::Version.new(version).to_s == version
  abort "stamp-version: #{version.inspect} is not a canonical gem version"
end

pattern = /^(\s*VERSION = )"[^"]*"$/
source = File.binread(path)
count = source.scan(pattern).size
abort "stamp-version: expected one VERSION literal in #{path}, found #{count}" unless count == 1

File.binwrite path, source.sub(pattern) { "#{$1}\"#{version}\"" }

# Ruby, not the pattern, decides what the gem reports: a second assignment, a
# block comment or a suffix the pattern cannot see would otherwise ship.
loaded, status = Open3.capture2({ "RUBYOPT" => nil, "BUNDLE_GEMFILE" => nil }, RbConfig.ruby, "--disable-gems",
  "-e", "load ARGV[0]; print RailsInformant::VERSION", path, err: File::NULL)
unless status.success? && loaded == version
  File.binwrite path, source
  abort "stamp-version: #{path} loads as #{loaded.inspect}, not #{version.inspect}; restored it"
end
