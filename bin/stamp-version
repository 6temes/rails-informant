#!/usr/bin/env ruby
# Stamps a release version into version.rb before the gem is built:
#
#   bin/stamp-version VERSION FILE
#
# Stdlib only: the publish job installs no gems.

abort "usage: bin/stamp-version VERSION FILE" unless ARGV.size == 2
version, path = ARGV

# `1.2.3-rc1` builds as `1.2.3.pre.rc1`, and the publish job pushes the gem file
# named for the tag, which would then not exist.
unless Gem::Version.correct?(version) && Gem::Version.new(version).to_s == version
  abort "stamp-version: #{version.inspect} is not a canonical gem version"
end

pattern = /^(\s*VERSION = )"[^"]*"$/
source = File.read(path)
count = source.scan(pattern).size
abort "stamp-version: expected one VERSION literal in #{path}, found #{count}" unless count == 1

stamped = "#{path}.stamped"
File.write stamped, source.sub(pattern) { "#{$1}\"#{version}\"" }

# The pattern cannot see a block comment, a suffix or a later reassignment, so
# Ruby loads the stamped copy as `gem build` would and compares the version
# itself. Only the exit status is read: the file could print anything.
# version.rb is replaced only once the copy passes.
check = "load ARGV[0]; exit(RailsInformant::VERSION == ARGV[1])"
begin
  unless system({ "RUBYOPT" => nil, "BUNDLE_GEMFILE" => nil }, RbConfig.ruby, "-e", check, File.expand_path(stamped), version, out: File::NULL, err: File::NULL)
    abort "stamp-version: #{path} does not load as #{version.inspect} once stamped; left it unchanged"
  end
  File.rename stamped, path
ensure
  File.delete stamped if File.exist?(stamped)
end
